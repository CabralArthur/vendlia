# ---------- Obrigatórias ----------
# Railway: use referências ${{Postgres.DATABASE_URL}} e ${{Redis.REDIS_URL}}
DATABASE_URL=postgres://user:pass@host:5432/vendlia
REDIS_URL=redis://default:pass@host:6379
# URL pública do painel (sem barra final)
APP_URL=https://app.seudominio.com.br
SESSION_SECRET=troque-por-uma-string-aleatoria-longa
# "false" bloqueia novos cadastros depois de criar sua conta
ALLOW_SIGNUP=true

# ---------- WhatsApp (Evolution API self-hosted no Railway) ----------
# URL interna é mais segura: http://evolution-api.railway.internal:8080
EVOLUTION_API_URL=https://evolution-xxxx.up.railway.app
EVOLUTION_API_KEY=mesmo-valor-de-AUTHENTICATION_API_KEY-da-evolution

# ---------- Sites publicados ----------
# Domínio curinga: <slug>.sites.seudominio.com.br  (configure *.sites... no Railway)
SITES_BASE_DOMAIN=

# ---------- IA (opcional — sem chave, usa regras determinísticas) ----------
LLM_PROVIDER=none            # anthropic | openai | none
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=                   # anthropic padrão: claude-haiku-5-5 ; openai: obrigatório
LLM_MONTHLY_BUDGET_USD=30

# ---------- Fontes de prospecção ----------
GOOGLE_PLACES_API_KEY=       # opcional; sem ela usa OpenStreetMap
OVERPASS_URL=https://overpass-api.de/api/interpreter

DATABASE_POOL_MAX=10

# Processamento em segundo plano roda dentro do serviço web. Use false só se tiver um serviço worker separado.
WORKER_IN_WEB=true
